        "width": 104,
        "height": 20
      },
      "kind": {
        "type": "text",
        "content": {
          "type": "static",
          "text": "GPU"
        },
        "style": {
          "font": {
            "family": "JetBrains Mono",
            "weight": 500
          },
          "size": 12,
          "paint": "#70736aff",
          "align": "left",
          "valign": "middle"
        }
      }
    },
    {
      "id": 9,
