      "frame": {
        "x": 42,
        "y": 36,
        "width": 530,
        "height": 35
      },
      "kind": {
        "type": "text",
        "content": {
          "type": "static",
          "text": "C L A R I T Y  /  W O R K S T A T I O N"
        },
        "style": {
          "font": {
            "family": "Inter",
            "weight": 500
          },
          "size": 22,
          "paint": "#26685dff",
          "align": "left",
          "valign": "middle"
        }
      }
    },
    {
      "id": 2,
